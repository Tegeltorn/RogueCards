; Engine configuration file.
config_version=5

[application]

config/name="RogueCards"
config/description="Roguelike deckbuilder prototype played with a standard 54-card deck."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.03, 0.12, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.03, 0.12, 1)
