; Engine configuration file.
config_version=5

[application]

config/name="RogueCards"
config/description="Roguelike deckbuilder prototype played with a standard 54-card deck."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.937, 0.894, 0.796, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.937, 0.894, 0.796, 1)
